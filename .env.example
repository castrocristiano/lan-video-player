# Porta exposta no host (8090 por padrão para evitar conflito com 8080 no dc1)
LVP_PORT=8090

# Diretórios do host montados em modo somente-leitura dentro de /media no container
LVP_HOST_HOME=/home/cristiano
LVP_HOST_MNT=/mnt

# Raízes fixas opcionais via CLI/Env (deixe vazio para gerenciar livremente pela Web UI)
LVP_MEDIA_DIRS=
